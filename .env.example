# Copy to .env.local for local development. Never commit real values.
# EAS reads the same names from its own Environment Variables UI/CLI for
# preview & production builds — this file documents what to set there too.

# Build profile: development | preview | production
APP_ENV=development

# EAS project id (eas.json / `eas init`)
EAS_PROJECT_ID=

# EAS Update URL for this project (`eas update:configure`)
EAS_UPDATE_URL=

# Sentry (leave blank to disable crash reporting locally)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional remote mantra catalog (falls back to the bundled JSON when unset
# or unreachable — see src/shared/data/mantraCatalog.ts)
REMOTE_CATALOG_URL=

# AdMob (leave blank to use Google's test IDs). App IDs look like
# ca-app-pub-XXXX~YYYY, banner unit IDs like ca-app-pub-XXXX/ZZZZ.
# Real ads only render in non-dev builds; dev always uses test ads.
ADMOB_ANDROID_APP_ID=
ADMOB_IOS_APP_ID=
ADMOB_BANNER_ANDROID=
ADMOB_BANNER_IOS=
